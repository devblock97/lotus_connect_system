# Server Configuration
PORT=8080
HOST=0.0.0.0
APP_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lotus_connect

# Cache Connection (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Security Configuration
# Generate secure 32+ byte strings for production
JWT_SECRET=supersecretjwtkeythatisextremelysecureandthirtytwobyteslong
JWT_REFRESH_SECRET=anothersecretrandomkeyforrefreshingtokensthatissecure

# JWT Expiration Configuration
JWT_ACCESS_EXPIRATION_MINUTES=43200
JWT_REFRESH_EXPIRATION_DAYS=30

# File Storage Configuration
UPLOAD_DIR=./uploads

# S3 / MinIO / R2 Upload Settings (Optional)
# S3_BUCKET=lotus-connect-uploads
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
